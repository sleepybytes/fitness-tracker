# Copy to .env.local (git-ignored) and fill in.

# Your Apple Developer Team ID: Xcode → Settings → Accounts → your team, or developer.apple.com → Membership.
APPLE_TEAM_ID=

# Unique app ID for your build, e.g. com.yourname.fitnesstracker (must be unique to your Apple account).
# Keep it the same once installed; changing it installs a separate app with empty data.
APP_BUNDLE_ID=

# Optional: name shown in the greeting ("Good morning, <name>").
EXPO_PUBLIC_USER_NAME=
